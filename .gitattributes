* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Canonical source, contracts, migrations, and evidence logs use LF.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.js text eol=lf
*.sha256 text eol=lf
*.xml text eol=lf

# Binary fixtures and runtime assets must never be normalized.
*.pic2model binary
*.zip binary
*.glb binary
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
ort-wasm*.mjs binary

# Large runtime artifacts are versioned through Git LFS so the portable app,
# native libraries, and inference models can be published with the repository.
*.exe filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.pyd filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
*.lib filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text

# Ollama model blobs have content-addressed names without extensions.
resources/local-models/ollama/models/blobs/* filter=lfs diff=lfs merge=lfs -text
