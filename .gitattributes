* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Canonical source, contracts, migrations, and evidence logs use LF.
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.js text eol=lf
*.sha256 text eol=lf
*.xml text eol=lf

# Binary fixtures and runtime assets must never be normalized.
*.aipicproject binary
*.zip binary
*.dll binary
*.exe binary
*.glb binary
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.onnx binary
*.wasm binary
ort-wasm*.mjs binary
