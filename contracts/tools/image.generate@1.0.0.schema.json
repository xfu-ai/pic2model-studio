      "summary": {
        "type": "string"
      },
      "tool_call_id": {
        "minLength": 1,
        "type": "string"
      },
      "ui_action": {
        "type": [
          "object",
          "null"
        ]
      },
      "warnings": {
        "items": {
          "type": "string"
        },
        "type": "array"
      }
    },
    "required": [
      "ok",
      "status",
      "tool_call_id",
      "output_asset_ids",
      "summary",
      "warnings",
      "expected_action",
      "ui_action",
      "job",
      "error",
      "reused"
