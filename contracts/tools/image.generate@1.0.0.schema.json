    "type": "object"
  },
  "name": "image.generate",
  "output_schema": {
    "additionalProperties": false,
    "properties": {
      "error": {
        "type": [
          "object",
          "null"
        ]
      },
      "expected_action": {
        "type": [
          "object",
          "null"
        ]
      },
      "job": {
        "type": [
          "object",
          "null"
        ]
      },
      "ok": {
        "type": "boolean"
      },
      "output_asset_ids": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "reused": {
        "type": "boolean"
      },
      "status": {
