      "aspect_ratio": {
        "type": "string"
      },
      "candidate_count": {
        "enum": [
          1,
          2,
          4
        ],
        "type": "integer"
      },
      "channel": {
        "enum": [
          "auto",
          "tripo",
          "meshy",
          "z_image"
        ]
      },
      "model": {
        "minLength": 1,
        "type": "string"
      },
      "output_format": {
        "enum": [
          "png",
          "jpg",
          "webp"
        ]
      },
      "prompt_asset_id": {
        "minLength": 1,
        "type": "string"
      },
      "provider_profile": {
        "minLength": 1,
        "type": "string"
      },
      "quality": {
        "type": "string"
      },
      "seed": {
        "maximum": 2147483647,
        "minimum": 0,
        "type": "integer"
      },
      "size": {
        "type": "string"
      },
      "steps": {
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
      },
      "structure_strength": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      }
    },
    "required": [
      "prompt_asset_id",
      "provider_profile",
      "channel",
      "model",
      "candidate_count"
